algoritmo "Primeiro Programa"

var
  idade: inteiro
  maioridadeCivil: inteiro
  maioridadePenal:inteiro

inicio

  idade <- 18
  maioridadeCivil <- 21
  maioridadePenal <- 18

  escreval("-- Idade: ", idade," --")
  escreval("-- Maioridade Civil: ", maioridadeCivil," --")
  escreval("-- Maioridade Penal: ", maioridadePenal," --")
  escreval("-----------------------------------------")

  escreval("É maior das duas idades? ", idade >= maioridadePenal e idade >= maioridadeCivil)
  escreval("É maior de alguma das idades? ", idade >= maioridadePenal ou idade >= maioridadeCivil)
  escreval("É menor de idade para ambas? ", nao(idade <= maioridadePenal e idade <= maioridadeCivil))

fimalgoritmo
